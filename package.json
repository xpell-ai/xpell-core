{
  "name": "@xpell/core",
  "version": "2.0.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Core runtime and interpreter for the Xpell engine (browser-based execution layer).",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/xpell-core.cjs.js",
  "module": "./dist/xpell-core.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/xpell-core.es.js",
      "require": "./dist/xpell-core.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "docs:api": "typedoc",
    "docs": "pnpm run docs:api",
    "test": "pnpm run build && node --test tests/xcommand-runtime.test.mjs",
    "publish-alpha-next": "pnpm version prerelease --preid=alpha && pnpm publish --tag alpha"
  },
  "xpell": {
    "_tests": [
      {
        "_id": "xpell-core.script.test",
        "_title": "@xpell/core test script",
        "_owner": "@xpell/core",
        "_suite": "xpell-core.package",
        "_scope": "package",
        "_runtime": "node",
        "_description": "Runs the existing @xpell/core package test script.",
        "_profiles": ["xpell-core.package"],
        "_tags": ["package", "script"],
        "_entry": {
          "_type": "script",
          "_script": "test"
        }
      },
      {
        "_id": "xpell-core.regression.xcommand-runtime",
        "_title": "XCommand runtime regression tests",
        "_owner": "@xpell/core",
        "_suite": "xpell-core.runtime",
        "_scope": "runtime",
        "_runtime": "node",
        "_description": "Existing runtime regression coverage in tests/xcommand-runtime.test.mjs.",
        "_profiles": ["xpell-core.package", "xpell-core.runtime"],
        "_tags": ["runtime", "regression"],
        "_entry": {
          "_type": "file",
          "_file": "tests/xcommand-runtime.test.mjs"
        }
      },
      {
        "_id": "xpell-core.package.check",
        "_title": "@xpell/core package metadata check",
        "_owner": "@xpell/core",
        "_suite": "xpell-core.package",
        "_scope": "package",
        "_runtime": "node",
        "_description": "Verifies package metadata and declared local entries without publishing or network checks.",
        "_profiles": ["xpell-core.package"],
        "_tags": ["package-check"],
        "_entry": {
          "_type": "package-check",
          "_check": "package"
        }
      }
    ],
    "_test_profiles": [
      {
        "_id": "xpell-core.package",
        "_title": "@xpell/core package verification",
        "_includes": ["xpell-core.*"],
        "_tags": ["package"]
      },
      {
        "_id": "xpell-core.runtime",
        "_title": "@xpell/core runtime regression",
        "_includes": ["xpell-core.regression.*"],
        "_tags": ["runtime", "regression"]
      }
    ]
  },
  "keywords": [
    "xpell",
    "xpell-core",
    "ui-engine",
    "realtime-ui",
    "runtime",
    "interpreter",
    "framework",
    "engine",
    "web-runtime",
    "browser-runtime",
    "event-loop",
    "frontend-engine",
    "xui",
    "x3d",
    "dom-engine",
    "typescript",
    "javascript"
  ],
  "author": "Tamir Fridman <fridman.tamir@gmail.com> (https://github.com/fridman-tamir)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpell-ai/xpell-core.git"
  },
  "devDependencies": {
    "typedoc": "^0.27.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  }
}
